# --- required in production ---
# Groq key (https://console.groq.com/keys). Server-side only: never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=
# 32+ random characters, e.g. `openssl rand -base64 48`. Signs score receipts and player cookies.
RECEIPT_SECRET=

# --- optional ---
# Model used for prompt writing, judging and hints.
GROQ_MODEL=openai/gpt-oss-120b
# Set to 1 to play offline with the built-in prompt pool (no Groq calls).
GROQ_MOCK=
# Shared storage for counts, leaderboards and runs (Upstash Redis REST). Without it,
# data lives in server memory: fine locally, but resets and isn't shared on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
